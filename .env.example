# URL de base de l'API réelle GdaHub (service financerh, via la passerelle nginx).
# Par défaut ("/api") : suppose que ce frontend est servi derrière la même
# passerelle que le backend (voir docker-compose.yml de GdaHub).
# En développement local, pointer directement sur la passerelle :
VITE_API_BASE_URL=http://localhost:8080/api
